{
  "name": "ai-sdlc-helper",
  "version": "0.1.0",
  "description": "Run an AI-driven SDLC pipeline (Spec, Plan, Red tests, Implement, Review, Ship) on any project, with Claude Code agents.",
  "keywords": [
    "sdlc",
    "claude",
    "claude-code",
    "ai",
    "agents",
    "tdd",
    "pipeline",
    "cli",
    "code-review"
  ],
  "license": "MIT",
  "author": "Anas",
  "type": "module",
  "bin": {
    "ai-sdlc-helper": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imaimai86/ai-sdlc-helper.git"
  },
  "homepage": "https://github.com/imaimai86/ai-sdlc-helper#readme",
  "bugs": {
    "url": "https://github.com/imaimai86/ai-sdlc-helper/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p test",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
